{
	"name": "omp-unified-exec",
	"version": "0.14.7",
	"description": "Codex-style unified_exec for omp: long-lived shell sessions the LLM polls and drives with write_stdin (Ctrl-C, arrow keys, PTY, REPLs, ssh, dev servers). Full output logged to disk.",
	"keywords": [
		"omp",
		"omp-extension",
		"codex",
		"unified-exec",
		"bash",
		"pty"
	],
	"license": "MIT",
	"author": "Ren Wang <iamwrm@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oh-my-omp/omp-unified-exec.git"
	},
	"homepage": "https://github.com/oh-my-omp/omp-unified-exec#readme",
	"type": "module",
	"scripts": {
		"check": "tsc --noEmit",
		"test": "npm run check && tsx --test tests/*.test.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"src",
		"fork-features/*.ts",
		"fork-features/tern-plugin",
		"README.md",
		"LICENSE"
	],
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.99.1",
		"@earendil-works/pi-tui": ">=0.99.1",
		"typebox": "*"
	},
	"optionalDependencies": {
		"@homebridge/node-pty-prebuilt-multiarch": "^0.14.1"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@earendil-works/pi-tui": "1.0.0",
		"@types/node": "^22.0.0",
		"tsx": "^4.23.12",
		"typebox": "1.3.27",
		"typescript": "^5.6.0"
	},
	"dependencies": {
		"@xterm/headless": "^6.0.0"
	}
}
