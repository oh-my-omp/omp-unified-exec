{
	"name": "omp-unified-exec",
	"version": "0.14.19",
	"description": "Long-lived PTY sessions for omp: send input with write_stdin, read terminal state via term://, and await events or completion with monitor. Full raw output logged to disk.",
	"keywords": [
		"omp",
		"omp-extension",
		"codex",
		"unified-exec",
		"bash",
		"pty"
	],
	"license": "MIT",
	"author": "Ren Wang <iamwrm@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oh-my-omp/omp-unified-exec.git"
	},
	"homepage": "https://github.com/oh-my-omp/omp-unified-exec#readme",
	"type": "module",
	"scripts": {
		"check": "tsc --noEmit",
		"test": "npm run check && bun test"
	},
	"engines": {
		"bun": ">=1.4"
	},
	"files": [
		"src",
		"fork-features/*.ts",
		"fork-features/topics/*.md",
		"README.md",
		"LICENSE"
	],
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.99.1",
		"@earendil-works/pi-tui": ">=0.99.1",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@earendil-works/pi-tui": "1.0.0",
		"@types/node": "^22.0.0",
		"typebox": "1.3.27",
		"typescript": "^5.6.0"
	},
	"dependencies": {
		"@xterm/headless": "^6.0.0"
	}
}
